# ─── Bot Tokens ──────────────────────────────────────────────────────────────
COMMANDS_BOT_TOKEN=your_commands_bot_token_here
EVENTS_BOT_TOKEN=your_events_bot_token_here
MINIGAMES_BOT_TOKEN=your_minigames_bot_token_here

# ─── Guild & Channel IDs ─────────────────────────────────────────────────────
GUILD_ID=your_guild_id_here
LOG_CHANNEL_ID=your_log_channel_id_here
MEMBER_COUNT_CHANNEL_ID=your_member_count_channel_id_here
FEEDBACK_CHANNEL_ID=your_feedback_channel_id_here

# ─── Role IDs ────────────────────────────────────────────────────────────────
MEMBER_ROLE_ID=your_member_role_id_here
FOUNDER_ROLE_ID=your_founder_role_id_here
MANAGER_ROLE_ID=your_manager_role_id_here
DEVELOPER_ROLE_ID=your_developer_role_id_here
GIVEAWAY_NOTIFY_ROLE_ID=your_giveaway_notify_role_id_here
TEAM_ROLE_ID=your_team_role_id_here
GARAGE_ROLE_ID=your_garage_role_id_here
HANDCUFFS_ROLE_ID=your_handcuffs_role_id_here
STORAGE_ROLE_ID=your_storage_role_id_here
VEHICLEKEYS_ROLE_ID=your_vehiclekeys_role_id_here

# ─── The FiveM server's MariaDB (only read by /backup_database) ──────────────
#
# This is the GAME server's database. The bot never writes here. For the bot's
# own storage see DATABASE_URL below.
DB_HOST=your_db_host_here
DB_USER=your_db_user_here
DB_PASS=your_db_pass_here
DB_NAME=your_db_name_here

# ─── The bot's own storage ───────────────────────────────────────────────────
#
# Leave this EMPTY or delete the line and the bot uses SQLite in
# data/multibot.db. That needs no database server, no credentials and no setup,
# and it is the right choice unless you already run something else.
#
# Set it to point somewhere else:
#
#   MariaDB / MySQL   DATABASE_URL=mysql://user:password@host:3306/dbname
#                     DATABASE_URL=mariadb://user:password@host:3306/dbname
#   PostgreSQL        DATABASE_URL=postgres://user:password@host:5432/dbname
#   SQLite elsewhere  DATABASE_URL=sqlite:/var/lib/multibot/multibot.db
#
# The tables are created on the first start, you only have to create the empty
# database and a user that may write to it.
#
# A URL the bot cannot parse makes it stop with an error instead of quietly
# falling back to SQLite — otherwise you would sit in front of an empty MariaDB
# wondering where the data went.
DATABASE_URL=

