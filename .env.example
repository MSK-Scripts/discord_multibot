# ─────────────────────────────────────────────────────────────────────────────
#  .env — credentials, and how this MACHINE is set up
# ─────────────────────────────────────────────────────────────────────────────
#
#  Two kinds of thing live here and nothing else:
#
#    1. Credentials: the bot tokens, the database password, the OAuth secret.
#    2. The web dashboard's own deployment settings, at the bottom. Its bind
#       address and port describe the machine, not the Discord server, and the
#       dashboard has to read them before it has any reason to look at a guild.
#
#  EVERYTHING ELSE lives in config/config.jsonc: the server and channel ids, the
#  roles, every switch, every panel and every button. The wording of what the
#  bot says lives in locales/ and config/texts.jsonc.
#
#  A setting with two homes is a setting where the two disagree and nobody can
#  tell which one won.
#
#  Coming from an older installation that kept everything in .env? Run
#  `npm run migrate:config` and it writes config/config.jsonc from this file.
#
# ─── Bot tokens ──────────────────────────────────────────────────────────────
#
# One per bot role. Three tokens means three separate Discord applications;
# using the SAME token for two roles is supported and puts both on one client,
# which is what avoids duplicate command registration.
#
# A role with no token is skipped at startup, so a setup with only the minigames
# bot is a valid setup.
COMMANDS_BOT_TOKEN=your_commands_bot_token_here
EVENTS_BOT_TOKEN=your_events_bot_token_here
MINIGAMES_BOT_TOKEN=your_minigames_bot_token_here

# ─── The FiveM server's MariaDB (only read by /backup_database) ──────────────
#
# This is the GAME server's database. The bot never writes here, it only runs
# mysqldump against it. Leave it empty unless you switch the backup feature on
# in config/config.jsonc. For the bot's OWN storage see DATABASE_URL below.
DB_HOST=your_db_host_here
DB_USER=your_db_user_here
DB_PASS=your_db_pass_here
DB_NAME=your_db_name_here

# ─── The bot's own storage ───────────────────────────────────────────────────
#
# Leave this EMPTY or delete the line and the bot uses SQLite in
# data/multibot.db. That needs no database server, no credentials and no setup,
# and it is the right choice unless you already run something else.
#
# Set it to point somewhere else:
#
#   MariaDB / MySQL   DATABASE_URL=mysql://user:password@host:3306/dbname
#                     DATABASE_URL=mariadb://user:password@host:3306/dbname
#   PostgreSQL        DATABASE_URL=postgres://user:password@host:5432/dbname
#   SQLite elsewhere  DATABASE_URL=sqlite:/var/lib/multibot/multibot.db
#
# The tables are created on the first start, you only have to create the empty
# database and a user that may write to it.
#
# A URL the bot cannot parse makes it stop with an error instead of quietly
# falling back to SQLite. Otherwise you would sit in front of an empty MariaDB
# wondering where the data went.
DATABASE_URL=

# ─── Web dashboard ───────────────────────────────────────────────────────────
#
# Started with `npm run dashboard`, which runs the bot as a CHILD process and
# serves the panel next to it. `node main.js` is unaffected and never loads a
# line of the web stack.
#
# THIS IS THE ONE PLACE WHERE THE SPLIT GOES THE OTHER WAY. Everything else that
# is not a credential lives in config/config.jsonc, but the panel's bind address
# and port describe how this MACHINE is set up, not what the bot does on your
# Discord server. Two installations of the same server config can want different
# ports, and the dashboard has to read this before it has any reason to look at
# a guild at all.
#
# OFF and LOOPBACK-ONLY by default, and both on purpose: a dashboard somebody
# started by accident is not reachable from another machine. If you DO bind it
# to a public interface without https it refuses to start, rather than serve
# session cookies and a "restart the bot" button over plaintext.
DASHBOARD_ENABLED=false

# Keep this on loopback and put a reverse proxy with TLS in front of it. Only
# change it if you know exactly why.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3020

# What the BROWSER uses. Behind a reverse proxy this is your public https
# address, NOT the bind address, and it has to match the redirect URI you
# register in the Discord developer portal:  <public URL>/auth/callback
# Empty falls back to http://<host>:<port>, which is right for a plain SSH tunnel.
DASHBOARD_PUBLIC_URL=

# Advanced, and normally wrong. Only when you terminate TLS somewhere the bot
# cannot see. Otherwise a public bind without https is refused, which is the point.
DASHBOARD_ALLOW_INSECURE=false

# The Discord APPLICATION whose OAuth is used for the login. The id is not a
# secret; the client secret next to it is. Both from the developer portal,
# OAuth2 -> Client Secret. Only needed once you switch the dashboard on.
CLIENT_ID=
CLIENT_SECRET=

# Signs the session cookies. GENERATED ON THE FIRST DASHBOARD START and written
# here, so leave it empty. Changing it signs everyone out. Never share it and
# never reuse one from another installation: a shared signing key means anybody
# who has it can forge a session on your panel.
SESSION_SECRET=
